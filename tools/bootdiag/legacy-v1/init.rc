# Temporary read-only Android log mirror; remove with the matching REMOVE ZIP.
on property:init.svc.logd=running
    start vendor.r8q_bootdiag

service vendor.r8q_bootdiag /system/bin/sh /vendor/bin/r8q-bootdiag.sh
    class core
    disabled
    oneshot
    user root
    group root log readproc
    seclabel u:r:logd:s0
