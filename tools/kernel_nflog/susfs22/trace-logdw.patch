+static void r8q_tee_log(const struct sock *peer, const struct sk_buff *skb)
+{
+	static const char endpoint[] = "/dev/socket/logdw";
+	const struct unix_address *address;
+	const char *status;
+	enum r8q_log_source owner;
+	/* Android packed id (1), tid (2), realtime (8), then priority, tag and text. */
+	enum { HEADER = 11, TEXT = HEADER + 1 };
+	char data[513], *tag, *message, *end;
+	size_t bytes, i;
+	int priority;
+
+	if (!peer || skb->len <= TEXT || ktime_get_boottime_seconds() >= 180)
+		return;
+	address = smp_load_acquire(&unix_sk(peer)->addr);
+	if (!address ||
+	    address->len < (int)(offsetof(struct sockaddr_un, sun_path) + sizeof(endpoint)) ||
+	    memcmp(address->name->sun_path, endpoint, sizeof(endpoint)))
+		return;
+	bytes = min_t(size_t, skb->len, sizeof(data) - 1);
+	if (skb_copy_bits(skb, 0, data, bytes))
+		return;
+	priority = data[HEADER];
+	if ((data[0] != 0 && data[0] != 3 && data[0] != 4) || priority < 4 || priority > 7)
+		return;
+	owner = r8q_log_owner();
+	if (owner == R8Q_OTHER)
+		return;
+	if (owner == R8Q_KEYSTORE && priority == 4)
+		owner = R8Q_COMPAT;
+	if (atomic_read(&r8q_log_counts[owner]) >= 48)
+		return;
+	data[bytes] = '\0';
+	tag = data + TEXT;
+	end = memchr(tag, '\0', min_t(size_t, bytes - TEXT, 64));
+	if (!end || end == tag || end + 1 >= data + bytes || !end[1])
+		return;
+	message = end + 1;
+	for (i = TEXT; i < bytes; i++) {
+		if (data[i] && (data[i] < ' ' || data[i] > '~'))
+			data[i] = ' ';
+	}
+	status = owner == R8Q_KEYSTORE ? message : r8q_hal_status(owner, tag, message, priority);
+	if (!status || atomic_inc_return(&r8q_log_counts[owner]) > 48)
+		return;
+	if (owner == R8Q_KEYSTORE)
+		pr_warn("R8QKEYSTORE pid=%d priority=%d tag=%s %s\n",
+			task_tgid_nr(current), priority, tag, status);
+	else
+		pr_warn("R8QTEE origin=%s pid=%d priority=%d tag=%s %s\n",
+			r8q_names[owner], task_tgid_nr(current), priority, tag, status);
+}
