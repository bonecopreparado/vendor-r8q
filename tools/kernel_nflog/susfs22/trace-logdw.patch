+/* Early Keymaster discovery takes place before /data and the log collector. */
+enum r8q_log_source {
+	R8Q_OTHER, R8Q_KEYSTORE, R8Q_COMPAT, R8Q_SAMSUNG_KM,
+	R8Q_STRONGBOX, R8Q_HWSM, R8Q_QSEE, R8Q_TEE, R8Q_SOURCE_COUNT
+};
+static const char * const r8q_contexts[R8Q_SOURCE_COUNT] = {
+	[R8Q_KEYSTORE] = "u:r:keystore:s0",
+	[R8Q_SAMSUNG_KM] = "u:r:hal_keymaster_default:s0",
+	[R8Q_STRONGBOX] = "u:r:vendor_hal_keymaster_qti:s0",
+	[R8Q_HWSM] = "u:r:hwservicemanager:s0",
+	[R8Q_QSEE] = "u:r:vendor_hal_qseecom_default:s0",
+	[R8Q_TEE] = "u:r:tee:s0",
+};
+static const char * const r8q_names[R8Q_SOURCE_COUNT] = {
+	[R8Q_COMPAT] = "compat", [R8Q_SAMSUNG_KM] = "samsung",
+	[R8Q_STRONGBOX] = "qti", [R8Q_HWSM] = "hwservicemanager",
+	[R8Q_QSEE] = "qsee-service", [R8Q_TEE] = "qsee-daemon",
+};
+static atomic_t r8q_log_counts[R8Q_SOURCE_COUNT];
+
+static enum r8q_log_source r8q_log_owner(void)
+{
+	char *context = NULL;
+	u32 secid, length;
+	enum r8q_log_source i, owner = R8Q_OTHER;
+
+	security_task_getsecid(current, &secid);
+	if (!secid || security_secid_to_secctx(secid, &context, &length))
+		return R8Q_OTHER;
+	for (i = R8Q_KEYSTORE; context && i < R8Q_SOURCE_COUNT; i++) {
+		if (r8q_contexts[i] && length == strlen(r8q_contexts[i]) + 1 &&
+		    !memcmp(context, r8q_contexts[i], length)) {
+			owner = i;
+			break;
+		}
+	}
+	security_release_secctx(context, length);
+	return owner;
+}
+
+/* Select service discovery, dynamic linker errors and startup status.
+ * Never forward arbitrary messages emitted by the hardware crypto services.
+ */
+static const char *r8q_hal_status(enum r8q_log_source owner,
+				  const char *tag, const char *msg, int priority)
+{
+	if (owner == R8Q_COMPAT) {
+		if (strstr(msg, "Skipping keymaster compat") ||
+		    strstr(msg, "found android.hardware.keymaster@") ||
+		    strstr(msg, "failed to create compat KeyMint device") ||
+		    strstr(msg, "Cannot list manifest for android.hardware.keymaster") ||
+		    strstr(msg, "KeystoreCompatService::getKeyMintDevice("))
+			return msg;
+		return NULL;
+	}
+	if (!strcmp(tag, "linker") && (strstr(msg, "CANNOT LINK EXECUTABLE") ||
+	    strstr(msg, "cannot locate symbol") || strstr(msg, "not accessible for the namespace")))
+		return msg;
+	if (!strcmp(tag, "libc") && strstr(msg, "Fatal signal"))
+		return msg;
+	if (owner == R8Q_HWSM) {
+		if (strstr(msg, "hwservicemanager is ready") || strstr(msg, "HIDL is not supported") ||
+		    strstr(msg, "Failed to set \"hwservicemanager.") ||
+		    strstr(msg, "android.hardware.keymaster@") ||
+		    strstr(msg, "vendor.qti.hardware.qseecom@") ||
+		    (!strcmp(tag, "libvintf") && priority >= 5))
+			return msg;
+		return NULL;
+	}
+	if (owner == R8Q_SAMSUNG_KM && (strstr(msg, "Keymaster HAL service is Ready") ||
+	    strstr(msg, "Could not register service for Keymaster HAL") ||
+	    strstr(msg, "Keymaster HAL failed to join thread pool")))
+		return msg;
+	if ((!strcmp(tag, "HidlServiceManagement") || !strcmp(tag, "ServiceManagement")) &&
+	    (strstr(msg, "android.hardware.keymaster@") || strstr(msg, "vendor.qti.hardware.qseecom@") ||
+	     strstr(msg, "hwservicemanager")))
+		return msg;
+	if (strstr(msg, "QSEECom_start_app") && (strstr(msg, "fail") || strstr(msg, "Fail")))
+		return "QSEECom_start_app failed";
+	if (strstr(msg, "skeymaster is not registered yet"))
+		return "skeymaster is not registered yet";
+	return NULL;
+}
