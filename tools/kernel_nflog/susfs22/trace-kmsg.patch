+/* Capture a few blocked-task stacks during the observed late /data stall. */
+static atomic_t r8q_mount_active = ATOMIC_INIT(0);
+static unsigned int r8q_mount_samples;
+static void r8q_mount_sample(struct work_struct *work);
+static DECLARE_DELAYED_WORK(r8q_mount_work, r8q_mount_sample);
+
+static bool r8q_mount_task(struct task_struct *group)
+{
+	char comm[TASK_COMM_LEN];
+
+	if (task_pid_nr(group) == 1)
+		return true;
+	get_task_comm(comm, group);
+	return !strcmp(comm, "vdc") || !strcmp(comm, "vold") ||
+	       !strcmp(comm, "keystore2");
+}
+
+static void r8q_mount_sample(struct work_struct *work)
+{
+	struct task_struct *group, *task, *saved[12];
+	unsigned int count = 0, i;
+
+	if (!atomic_read(&r8q_mount_active))
+		return;
+
+	/* Prioritize process leaders before including their binder workers. */
+	rcu_read_lock();
+	for_each_process(group) {
+		if (count >= ARRAY_SIZE(saved))
+			break;
+		if (r8q_mount_task(group)) {
+			get_task_struct(group);
+			saved[count++] = group;
+		}
+	}
+	for_each_process_thread(group, task) {
+		if (count < ARRAY_SIZE(saved) && task != group &&
+		    r8q_mount_task(group) &&
+		    (READ_ONCE(task->state) & (TASK_INTERRUPTIBLE | TASK_UNINTERRUPTIBLE))) {
+			get_task_struct(task);
+			saved[count++] = task;
+		}
+	}
+	rcu_read_unlock();
+
+	pr_warn("R8QMOUNT sample=%u tasks=%u\n", ++r8q_mount_samples, count);
+	for (i = 0; i < count; i++) {
+		task = saved[i];
+		pr_warn("R8QMOUNT task=%s pid=%d tgid=%d state=%ld exit_state=%d exit_code=%d\n",
+			task->comm, task_pid_nr(task), task_tgid_nr(task),
+			READ_ONCE(task->state), READ_ONCE(task->exit_state),
+			READ_ONCE(task->exit_code));
+		if (READ_ONCE(task->state) & (TASK_INTERRUPTIBLE | TASK_UNINTERRUPTIBLE))
+			sched_show_task(task);
+		put_task_struct(task);
+	}
+	pr_warn("R8QMOUNT end sample=%u\n", r8q_mount_samples);
+	if (r8q_mount_samples < 3 && atomic_read(&r8q_mount_active))
+		schedule_delayed_work(&r8q_mount_work, msecs_to_jiffies(35000));
+}
+
+static void r8q_mount_mark(const char *message)
+{
+	static const char begin[] = "<4>R8QTRACE vendor mount-all:begin ";
+	static const char end[] = "<4>R8QTRACE vendor mount-all:end ";
+
+	if (!strncmp(message, begin, sizeof(begin) - 1) &&
+	    atomic_cmpxchg(&r8q_mount_active, 0, 1) == 0)
+		schedule_delayed_work(&r8q_mount_work, msecs_to_jiffies(8000));
+	else if (!strncmp(message, end, sizeof(end) - 1)) {
+		atomic_set(&r8q_mount_active, 0);
+		cancel_delayed_work(&r8q_mount_work);
+	}
+}
+
+static bool r8qtrace_context(const char *expected)
+{
+	char *context = NULL;
+	u32 secid, length;
+	bool allowed;
+
+	security_task_getsecid(current, &secid);
+	if (!secid || security_secid_to_secctx(secid, &context, &length))
+		return false;
+
+	allowed = context && length == strlen(expected) + 1 &&
+		  !memcmp(context, expected, length);
+	security_release_secctx(context, length);
+	return allowed;
+}
+
+/* Retain only early storage diagnostics from the existing SELinux domains. */
+static atomic_t r8q_storage_messages = ATOMIC_INIT(0);
+static atomic_t r8q_hal_init_messages = ATOMIC_INIT(0);
+
+static void r8q_storage_log(char *record, size_t length, bool from_init)
+{
+	const char *origin;
+	char *payload, *end;
+	unsigned long priority;
+	size_t i;
+
+	if (ktime_get_boottime_seconds() >= 180 || record[0] != '<' ||
+	    record[1] < '0' || record[1] > '9')
+		return;
+
+	record[length] = '\0';
+	priority = simple_strtoul(record + 1, &end, 10);
+	if (*end != '>' || end - record > 4 || priority > 191)
+		return;
+	payload = end + 1;
+	if (!*payload)
+		return;
+
+	/* Keep init's service transitions independent of the vold budget. */
+	if (from_init && (priority & 7) <= 6 && !strncmp(payload, "init: ", 6) &&
+	    (strstr(payload, "'vendor.keymaster-4-0'") || strstr(payload, "'hwservicemanager'") ||
+	     strstr(payload, "'qseecom-service'") || strstr(payload, "'vendor.qseecomd'"))) {
+		if (atomic_read(&r8q_hal_init_messages) < 48 &&
+		    atomic_inc_return(&r8q_hal_init_messages) <= 48) {
+			for (i = payload - record; i < length; i++) {
+				if (record[i] < ' ' || record[i] > '~')
+					record[i] = ' ';
+			}
+			pr_warn("R8QTEE origin=init %s\n", payload);
+		}
+		return;
+	}
+
+	if (from_init) {
+		if ((priority & 7) > LOGLEVEL_WARNING ||
+		    strncmp(payload, "init: ", 6) ||
+		    (!strstr(payload, "vold") && !strstr(payload, "vdc") &&
+		     !strstr(payload, "keystore2") && !strstr(payload, "mount_all")))
+			return;
+		origin = "init";
+	} else if (!strncmp(payload, "vold: ", 6) &&
+		   (priority & 7) <= LOGLEVEL_WARNING &&
+		   r8qtrace_context("u:r:vold:s0")) {
+		origin = "vold";
+	} else if (!strncmp(payload, "vdc: ", 5) &&
+		   r8qtrace_context("u:r:vdc:s0")) {
+		origin = "vdc";
+	} else {
+		return;
+	}
+
+	if (atomic_read(&r8q_storage_messages) >= 96 ||
+	    atomic_inc_return(&r8q_storage_messages) > 96)
+		return;
+	while (length && (record[length - 1] == '\n' || record[length - 1] == '\r'))
+		record[--length] = '\0';
+	for (i = payload - record; i < length; i++) {
+		if (record[i] < ' ' || record[i] > '~')
+			record[i] = ' ';
+	}
+	pr_warn("R8QVOLD origin=%s pid=%d %s\n", origin, task_pid_nr(current), payload);
+}
