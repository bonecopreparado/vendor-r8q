+static bool r8qtrace_from_vendor_init(void)
+{
+	static const char expected[] = "u:r:vendor_init:s0";
+	char *context = NULL;
+	u32 secid, length;
+	bool allowed;
+
+	security_task_getsecid(current, &secid);
+	if (!secid || security_secid_to_secctx(secid, &context, &length))
+		return false;
+
+	allowed = context && length == sizeof(expected) &&
+		  !memcmp(context, expected, sizeof(expected));
+	security_release_secctx(context, length);
+	return allowed;
+}
